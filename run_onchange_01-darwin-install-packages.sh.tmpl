{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

{{ if eq (env "CI") "true" -}}
# CI only needs the bootstrap tools. Installing desktop casks here makes the
# bootstrap test depend on unrelated third-party downloads.
brew install mise yq
{{ else -}}
# デフォルトのパッケージをインストール
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
{{ end -}}
