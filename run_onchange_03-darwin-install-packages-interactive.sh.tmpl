#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}

set -euo pipefail

need() { command -v "$1" >/dev/null 2>&1 || { echo "$1 が必要です"; exit 1; }; }
need mise
need brew

CASKS_FILE="$(mktemp)"; CHOICES_FILE="$(mktemp)"
cleanup() { rm -f "$CASKS_FILE" "$CHOICES_FILE"; }
trap 'cleanup' 0 1 2 15

# chezmoiが読み込んだデータから候補を生成
cat >"$CASKS_FILE" <<'EOF'
{{ range .packages.darwin.available_casks -}}
{{ . }}
{{ end -}}
EOF

if [ ! -s "$CASKS_FILE" ]; then
  echo "選択肢がありません"
  exit 1
fi

# ヘッダー（選択不可の見出し）
HEADER="== CASK ==
$(cat "$CASKS_FILE")"

# 先頭にキャンセル用の行を入れる
printf '［何もしない］\n' > "$CHOICES_FILE"
while IFS= read -r p; do
  [ -n "$p" ] && printf '%s\n' "$p" >> "$CHOICES_FILE"
done < "$CASKS_FILE"

# fzf 起動（複数選択可）
SELECTED="$(mise exec -- fzf -m \
  --prompt='インストールするパッケージを選んでください > ' \
  --header="$HEADER" < "$CHOICES_FILE" || true)"

# Esc / 何も選ばない → 何もせず終了
[ -z "$SELECTED" ] && exit 0

# 「［何もしない］」が含まれてたら終了
printf '%s\n' "$SELECTED" | grep -Fxq '［何もしない］' && exit 0

# まとめてインストール
printf '%s\n' "$SELECTED" | while IFS= read -r PKG; do
  echo "==> brew install --cask $PKG"
  brew install --cask "$PKG"
done

{{ end -}}
